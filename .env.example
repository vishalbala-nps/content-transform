# LLM_PROVIDER=gemini  gemini or ollama; see README "Model provider"

# Gemini Settings:

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama Settings:

# OLLAMA_MODEL=qwen3:latest
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384   context window; long sources need more
# OLLAMA_TIMEOUT_S=600   a brief takes minutes on a laptop

# Other Settings

# LLM_CONCURRENCY=3   model calls in flight at once; do not raise to go faster
# LLM_CACHE=1         dev cache under .cache/llm/; set to 0 for demo runs
# LLM_CACHE_DELAY_S=0 dev only: cache hits wait this long, to test job progress without quota
# DATABASE_URL=sqlite:///storage/app.db   jobs and their results
